apiVersion: "k8s.cni.cncf.io/v1"
kind: NetworkAttachmentDefinition
metadata:
  name: {{ nad_name }}
  namespace: {{ name_space }}
  annotations:
    k8s.v1.cni.cncf.io/resourceName: {{ resource_name }}
  labels:
    tft-tests: "secondary-nad"
spec:
  config: '{
    "cniVersion": "0.4.0",
    "type": "sriov",
    "vlan": {{ vlan }}
  }'
